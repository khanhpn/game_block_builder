{
  "name": "neon-blocks",
  "author": "Khanh Pham",
  "description": "A polished browser-based Tetris game with neon arcade visuals.",
  "homepage": "https://khanhpn.github.io/game_block_builder",
  "repository": {
    "type": "git",
    "url": "https://github.com/khanhpn/game_block_builder.git"
  },
  "license": "MIT",
  "keywords": [
    "tetris",
    "react",
    "typescript",
    "vite",
    "game",
    "arcade"
  ],
  "contributors": [
    {
      "name": "Khanh Pham",
      "email": "phamkhanh90@gmail.com",
      "url": "https://github.com/khanhpn"
    }
  ],
  "bugs": {
    "url": "https://github.com/khanhpn/game_block_builder/issues"
  },
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,md,json,yml,yaml,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "husky": "^9.1.7",
    "jsdom": "latest",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "latest",
    "vitest": "^4.1.10"
  }
}
